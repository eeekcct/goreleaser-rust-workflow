{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Asia/Tokyo",
  packageRules: [
    {
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
    {
      // SLSA requires a version tag for reusable workflows as well as actions.
      matchManagers: ["github-actions"],
      matchPackageNames: ["slsa-framework/slsa-github-generator"],
      pinDigests: false,
    },
  ],
  customManagers: [
    {
      // The built-in GitHub Actions manager does not extract syft-version.
      customType: "regex",
      managerFilePatterns: ["/^\\.github\\/workflows\\/release\\.yml$/"],
      matchStrings: ["syft-version: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      depNameTemplate: "anchore/syft",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on Monday"],
  },
  automerge: true,
  platformAutomerge: true,
  ignoreTests: false,
  labels: ["dependencies"],
  commitMessagePrefix: "chore(deps):",
  prHourlyLimit: 2,
  prConcurrentLimit: 10,
}
